---
import Container from '../../../core/ui/Container.astro';
import SectionHeading from '../../../core/ui/SectionHeading.astro';
import { gallery } from '../../../core/config';

const categories = [
	{ id: 'todos', label: 'Todos' },
	{ id: 'cortes', label: 'Cortes' },
	{ id: 'barbas', label: 'Barbas' },
	{ id: 'fade', label: 'Fade' },
	{ id: 'disenos', label: 'Diseños' },
];
---

<section class="gallery" id="gallery">
	<Container>
		<SectionHeading
			title="Nuestro Trabajo"
			subtitle="Cada corte habla por nosotros."
		/>

		<div class="filters">
			{categories.map((cat) => (
				<button class="filter-btn" data-filter={cat.id}>
					{cat.label}
				</button>
			))}
		</div>

		<div class="grid">
			{gallery.map((item) => (
				<button
					class="item hover-lift"
					data-category={item.category}
					data-alt={item.alt}
				>
					<span class="placeholder">{item.category}</span>
				</button>
			))}
		</div>
	</Container>

	<div class="lightbox" id="lightbox">
		<button class="close" id="lightbox-close" aria-label="Cerrar">✕</button>
		<div class="lightbox-content">
			<span class="lightbox-placeholder" id="lightbox-placeholder"></span>
			<p id="lightbox-alt"></p>
		</div>
	</div>
</section>

<style>
	.gallery {
		padding-block: var(--section-spacing);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		margin-bottom: 2.5rem;
	}

	.filter-btn {
		padding: 0.5rem 1.25rem;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--light-gray);
		border: 1px solid var(--light-gray);
		border-radius: var(--border-radius);
		transition: all 0.3s ease;
	}

	.filter-btn:hover {
		color: var(--white);
		border-color: var(--white);
	}

	.filter-btn.active {
		color: var(--black);
		background-color: var(--gold);
		border-color: var(--gold);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	@media (min-width: 768px) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.item {
		aspect-ratio: 3 / 4;
		background-color: var(--dark-gray);
		border: 1px solid var(--light-gray);
		border-radius: var(--border-radius);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.item.hidden {
		display: none;
	}

	.placeholder {
		font-family: var(--font-heading);
		font-size: 1.2rem;
		text-transform: capitalize;
		color: var(--light-gray);
	}

	.lightbox {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 100;
		background-color: rgba(10, 10, 10, 0.95);
		align-items: center;
		justify-content: center;
	}

	.lightbox.open {
		display: flex;
	}

	.close {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		font-size: 1.5rem;
		color: var(--white);
	}

	.lightbox-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.lightbox-placeholder {
		width: min(80vw, 500px);
		aspect-ratio: 3 / 4;
		background-color: var(--dark-gray);
		border: 1px solid var(--gold);
		border-radius: var(--border-radius);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-heading);
		font-size: 1.4rem;
		text-transform: capitalize;
		color: var(--gold);
	}

	#lightbox-alt {
		color: var(--light-gray);
		font-size: 0.9rem;
	}
</style>

<script>
	const filterButtons = document.querySelectorAll('.filter-btn');
	const items = document.querySelectorAll('.item');
	const lightbox = document.getElementById('lightbox');
	const lightboxClose = document.getElementById('lightbox-close');
	const lightboxPlaceholder = document.getElementById('lightbox-placeholder');
	const lightboxAlt = document.getElementById('lightbox-alt');

	filterButtons[0]?.classList.add('active');

	filterButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			filterButtons.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');

			const filter = btn.getAttribute('data-filter');

			items.forEach((item) => {
				const category = item.getAttribute('data-category');
				const matches = filter === 'todos' || category === filter;
				item.classList.toggle('hidden', !matches);
			});
		});
	});

	items.forEach((item) => {
		item.addEventListener('click', () => {
			const category = item.getAttribute('data-category') ?? '';
			const alt = item.getAttribute('data-alt') ?? '';

			if (lightboxPlaceholder) lightboxPlaceholder.textContent = category;
			if (lightboxAlt) lightboxAlt.textContent = alt;
			lightbox?.classList.add('open');
		});
	});

	lightboxClose?.addEventListener('click', () => {
		lightbox?.classList.remove('open');
	});

	lightbox?.addEventListener('click', (e) => {
		if (e.target === lightbox) {
			lightbox.classList.remove('open');
		}
	});
</script>
