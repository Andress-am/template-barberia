---
import Container from '../../../core/ui/Container.astro';
import { business } from '../../../core/config';

const links = [
	{ label: 'Inicio', href: '#hero' },
	{ label: 'Servicios', href: '#services' },
	{ label: 'Galería', href: '#gallery' },
	{ label: 'Nosotros', href: '#about' },
	{ label: 'Barberos', href: '#team' },
	{ label: 'Reservaciones', href: '#booking' },
	{ label: 'Contacto', href: '#location' },
];
---

<footer class="footer">
	<Container>
		<div class="grid">
			<div>
				<p class="logo">{business.name}</p>
				<p class="tagline">{business.tagline}</p>
			</div>

			<div class="col">
				<p class="col-title">Enlaces</p>
				{links.map((l) => <a href={l.href}>{l.label}</a>)}
			</div>

			<div class="col">
				<p class="col-title">Contacto</p>
				<p>{business.phone}</p>
				<p>{business.whatsapp}</p>
				<p>{business.address}</p>
			</div>

			<div class="col">
				<p class="col-title">Redes</p>
				<a href={business.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
				<a href={business.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
				<a href={business.social.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a>
			</div>
		</div>

		<div class="bottom">
			<div class="legal">
				<a href="#">Aviso de privacidad</a>
				<a href="#">Términos y condiciones</a>
			</div>
			<p>© 2026 {business.name}. Todos los derechos reservados.</p>
		</div>
	</Container>
</footer>

<style>
	.footer {
		padding-block: var(--section-spacing) 2rem;
		border-top: 1px solid var(--light-gray);
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		margin-bottom: 3rem;
	}

	@media (min-width: 768px) {
		.grid {
			grid-template-columns: 2fr 1fr 1fr 1fr;
		}
	}

	.logo {
		font-family: var(--font-heading);
		font-size: 1.4rem;
		margin-bottom: 0.5rem;
	}

	.tagline {
		color: var(--light-gray);
		font-size: 0.9rem;
	}

	.col {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.col-title {
		text-transform: uppercase;
		font-size: 0.8rem;
		letter-spacing: 0.03em;
		color: var(--gold);
		margin-bottom: 0.4rem;
	}

	.col a,
	.col p {
		color: var(--light-gray);
		font-size: 0.9rem;
	}

	.col a:hover {
		color: var(--white);
	}

	.bottom {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		text-align: center;
		padding-top: 2rem;
		border-top: 1px solid var(--light-gray);
		font-size: 0.8rem;
		color: var(--light-gray);
	}

	.legal {
		display: flex;
		gap: 1.5rem;
	}

	.legal a {
		color: var(--light-gray);
	}

	.legal a:hover {
		color: var(--gold);
	}
</style>
