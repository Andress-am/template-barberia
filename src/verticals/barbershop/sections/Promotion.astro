---
import Container from '../../../core/ui/Container.astro';
import Button from '../../../core/ui/Button.astro';
import { promotionContent, features } from '../../../core/config';
---

{features.promotion.active && (
	<section class="promotion" id="promotion">
		<Container>
			<div class="box">
				<h2>{promotionContent.title}</h2>
				<p>{promotionContent.description}</p>
				<p class="price">{promotionContent.price}</p>
				<Button variant="primary" href="#booking">Reservar Ahora</Button>
			</div>
		</Container>
	</section>
)}

<style>
	.promotion {
		padding-block: var(--section-spacing);
	}

	.box {
		text-align: center;
		background: linear-gradient(180deg, var(--dark-gray) 0%, var(--black) 100%);
		border: 1px solid var(--gold);
		border-radius: var(--border-radius);
		padding: 4rem 2rem;
	}

	h2 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		margin-bottom: 0.75rem;
	}

	.box p {
		color: var(--light-gray);
		margin-bottom: 0.5rem;
	}

	.price {
		font-family: var(--font-heading);
		font-size: 2rem;
		color: var(--gold);
		margin-bottom: 1.5rem;
	}
</style>
