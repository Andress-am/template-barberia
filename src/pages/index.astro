---
import Base from '../core/layouts/Base.astro';
import { seo } from '../core/config';
import Navbar from '../verticals/barbershop/sections/Navbar.astro';
import Hero from '../verticals/barbershop/sections/Hero.astro';
import Services from '../verticals/barbershop/sections/Services.astro';
import Gallery from '../verticals/barbershop/sections/Gallery.astro';
import About from '../verticals/barbershop/sections/About.astro';
import Team from '../verticals/barbershop/sections/Team.astro';
import Booking from '../verticals/barbershop/sections/Booking.astro';
import Testimonials from '../verticals/barbershop/sections/Testimonials.astro';
import Promotion from '../verticals/barbershop/sections/Promotion.astro';
import Location from '../verticals/barbershop/sections/Location.astro';
import FAQ from '../verticals/barbershop/sections/FAQ.astro';
import CTA from '../verticals/barbershop/sections/CTA.astro';
import Footer from '../verticals/barbershop/sections/Footer.astro';
---

<Base title={seo.title} description={seo.description}>
	<Navbar />
	<Hero />
	<Services />
	<Gallery />
	<About />
	<Team />
	<Booking />
	<Testimonials />
	<Promotion />
	<Location />
	<FAQ />
	<CTA />
	<Footer />
</Base>
